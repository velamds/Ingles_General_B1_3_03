xt"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}]}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn8le03ob05re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Watch a TV show or a movie about the criminal justice system.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "contents": [{}], "id": 0}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn8le03ob05re2aud01", "coverimg": "engenn8le03ob05re2img05.jpg", "images": [{"image": "engenn8le03ob05re2img05.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn8le03ob05re2img05.jpg", "text": "I was reading the news the other day when I came across an article that talked about a trial by judge. I had never heard of that before. I decided to Google it. While I was reading about it, I thought that it would be a good topic to blog about. Here is what I learned: Trials are supposed to take place in situations when individuals or companies are accused of breaking the law. The crime could be major, such as murder or treason against the government, or a misdemeanor such as petty theft or minor damage to property.", "id": 1, "time": "100"}, {"image": "engenn8le03ob05re2img02.jpg", "text": "There are two main types of trials: trial by jury and trial by judge. In some countries, there are only judge trials, but in other countries there are both types of trials, depending on the nature of the case. Cases involving misdemeanors are generally tried by judge. Major crimes are generally tried by jury.", "id": 2, "time": "33000"}, {"image": "engenn8le03ob05re2img01.jpg", "text": "In a jury trial, twelve people are supposed to decide whether the accused is guilty or innocent. If guilty, the judge decides on the severity of the punishment, sometimes with input from the jury.\nBefore the trial, the defense and the prosecution are supposed to interview the people on the jury and decide if they are acceptable. They are allowed to reject some potential jurors \u2013 those they think will be damaging to their side.", "id": 3, "time": "54500"}]}}], "id": 1}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "Crime and Punishment", "type": "lesson_name"}, {"content": "Court Trials", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Identify and describe rules and obligations through a wider range of language and expressions in both work and social contexts.", "type": "primary"}, {"content": "Understands important and specific information in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Be Supposed To ", "type": "heading"}, {"content": "You use the structure <span class=\"strong\">be supposed to </span>when you want to talk about expectations, obligations or arrangements.", "type": "describer"}, {"content": "You can use <span class=\"strong\">be supposed to</span> to talk about situations in the past, present or future.<br /><br />  The structure is:<br /><br />  Subject + To be + supposed to + verb<br /><br />  <span class=\"italic\">Twelve people <span class=\"strong\">are supposed to decide </span>whether the accused is guilty or innocent. </span> <br /><br /><br />   **Pronunciation tip**:<br /> When you say be supposed to, you link the /d/ and /t/ sounds together. <br /><br />  Like this:<br /> Be suppose_to", "type": "text"}, {"content": "Before the trial, the defense and the prosecution are supposed to interview the people on the jury and decide if they are acceptable.", "type": "example"}, {"content": "Trials are supposed to take place in situations when individuals or companies are accused of breaking the law.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " The Past Continuous Tense", "type": "heading"}, {"content": " You use the Past Continuous tense to talk about an action that was happening at a time before now. ", "type": "describer"}, {"content": "You can use the Past Continuous to:<br /><br />  <ul> \t<li>to describe the background in a story written in the past tense </li> </ul> For example: <br /><span class=\"italic\">The children <span class=\"strong\">were laughing </span>and the birds <span class=\"strong\">were singing</span> in the park. A woman <span class=\"strong\">was looking </span>for her phone, which she had dropped somewhere ...</span><br /><br />  <ul> \t<li>to describe an action that was interrupted by another event or action</li> </ul>  For example:<br /><span class=\"italic\"> I <span class=\"strong\">was reading </span>the news the other day <span class=\"strong\">when I came across </span>an article that talked about a trial by judge.</span><br /><br />  The form of the Past Continuous is:<br /><br />  Subject + was/were + verb-ing", "type": "text"}, {"content": "While I was reading about it, I thought that it would be a good topic to blog about. ", "type": "example"}, {"content": "I was reading the news the other day when I came across an article that talked about a trial by judge.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to break the law ", "type": "name"}, {"content": "to do something that is not allowed by law", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Trials are supposed to take place in situations when individuals or companies are accused of breaking the law. ", "type": "example"}, {"content": "engenn8le03ob05aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about crime and punishment.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "treason ", "type": "name"}, {"content": " the crime of betraying your own country", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The crime could be major, such as murder or treason against the government.", "type": "example"}, {"content": "engenn8le03ob05aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "misdemeanor ", "type": "name"}, {"content": " a less serious offense", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Minor damage to property is a misdemeanor.", "type": "example"}, {"content": "engenn8le03ob05aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "petty theft", "type": "name"}, {"content": "stealing a small amount of money or goods", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Petty theft is a misdemeanor.", "type": "example"}, {"content": "engenn8le03ob05aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "jury ", "type": "name"}, {"content": "a group of people who decide guilt or innocence in a court of law", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There are two main types of trials: trial by jury and trial by judge. ", "type": "example"}, {"content": "engenn8le03ob05aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "nature ", "type": "name"}, {"content": "kind; type", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There are both types of trials, depending on the nature of the case.", "type": "example"}, {"content": "engenn8le03ob05aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "severity ", "type": "name"}, {"content": "strictness", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: If guilty, the judge decides on the severity of the punishment.", "type": "example"}, {"content": "engenn8le03ob05aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "prosecution ", "type": "name"}, {"content": " a team of lawyers who represent the law ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Before the trial, the defense and the prosecution are supposed to interview the people on the jury and decide if they are acceptable. ", "type": "example"}, {"content": "engenn8le03ob05aud08", "type": "audio"}]}, {"content": "engenn8le03ob05re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Watch a TV show or movie about the criminal justice system or a trial.", "type": "text"}, {"content": "While you are watching, write down things that you learn or that surprise you about justice.", "type": "text"}, {"content": "Write a summary of the TV show or movie and write sentences about the new or surprising facts you learned.", "type": "text"}, {"content": "In your group, make a short presentation about what you watched and learned.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about rules, regulations, crime and punishment.", "type": "text"}, {"content": "I talk about what is supposed to happen.", "type": "text"}, {"content": "I talk about what I was doing or what was happening.", "type": "text"}, {"content": "I deliver a presentation.", "type": "text"}]}]}